PORT=25000
MONGODB_URI=mongodb://localhost:27017/creadent
JWT_SECRET=your_jwt_secret_key

# Local development (default)
# FRONTEND_URL=http://localhost:3000
# NODE_ENV=development

# Production
FRONTEND_URL=https://creadentsmiles.com
NODE_ENV=production

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_APPOINTMENT_BOOKED_PATIENT=appointment_booked_patient
WHATSAPP_TEMPLATE_APPOINTMENT_BOOKED_DOCTOR=appointment_booked_doctor
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER_PATIENT=appointment_reminder_patient
WHATSAPP_REMINDER_POLL_INTERVAL_MS=300000

# Email (SMTP / Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=test@gmail.com
SMTP_PASS=your_gmail_app_password_here

# SpaceBite / S3-compatible Storage (optional, auto-falls back to local uploads folder)
# Leave these blank to use local storage (files saved under backend/uploads/ folder, served from /files/)
SPACEBITE_ENDPOINT=https://sg1.spacebite.com                 # e.g., https://sg1.spacebite.com or similar
SPACEBITE_ACCESS_KEY=SpaceBiteAccessKey               # SpaceBite / S3 access key id
SPACEBITE_SECRET_KEY=SpaceBiteSecretKey                # SpaceBite / S3 secret access key
SPACEBITE_BUCKET=creadent            # Bucket name
SPACEBITE_REGION=auto                # Region, "auto" or actual region
SPACEBITE_BASE_URL=https://creadent.s.spacebite.com                # Optional: custom CDN base URL like https://cdn.yourdomain.com (no trailing slash)
