PORT=25000
MONGODB_URI=mongodb://localhost:27017/creadent
JWT_SECRET=your_jwt_secret_key

# Local development (default)
# FRONTEND_URL=http://localhost:3000
# NODE_ENV=development

# Production
FRONTEND_URL=https://creadentsmiles.com
NODE_ENV=production

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_APPOINTMENT_BOOKED_PATIENT=appointment_booked_patient
WHATSAPP_TEMPLATE_APPOINTMENT_BOOKED_DOCTOR=appointment_booked_doctor
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER_PATIENT=appointment_reminder_patient
WHATSAPP_TEMPLATE_INVOICE_SHARE=invoice_share_patient
WHATSAPP_TEMPLATE_LOGIN_CREDENTIALS=login_credentials_patient
WHATSAPP_REMINDER_POLL_INTERVAL_MS=300000

# Email (SMTP / Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=test@gmail.com
SMTP_PASS=your_gmail_app_password_here

# SpaceBite / S3-compatible Storage (optional, auto-falls back to local uploads folder)
# Leave these blank to use local storage (files saved under backend/uploads/ folder, served from /files/)
SPACEBITE_ENDPOINT=https://sg1.spacebite.com                 # e.g., https://sg1.spacebite.com or similar
SPACEBITE_ACCESS_KEY=SpaceBiteAccessKey               # SpaceBite / S3 access key id
SPACEBITE_SECRET_KEY=SpaceBiteSecretKey                # SpaceBite / S3 secret access key
SPACEBITE_BUCKET=creadent            # Bucket name
SPACEBITE_REGION=auto                # Region, "auto" or actual region
SPACEBITE_BASE_URL=https://creadent.s.spacebite.com                # Optional: custom CDN base URL like https://cdn.yourdomain.com (no trailing slash)

# ============================================================
# ICICI Bank Payment Gateway - PRODUCTION SETUP
# ============================================================
# DO NOT USE DEMO CREDENTIALS IN PRODUCTION
# Contact ICICI Bank to get merchant credentials
ICICI_ENV=production
ICICI_MERCHANT_ID=100000000007164
ICICI_AGGREGATOR_ID=A100000000007164
ICICI_SECRET_KEY=db06cca0-838b-4e01-8b20-6ac446ffb6bd
ICICI_CURRENCY_CODE=356
ICICI_PAY_TYPE=0

# Correct production endpoints
ICICI_INITIATE_SALE_URL=https://pgpay.icici.bank.in/pg/api/v2/initiateSale
ICICI_STATUS_CHECK_URL=https://pgpay.icici.bank.in/pg/api/command

# URL values must match exactly what is registered in the ICICI merchant portal
ICICI_RETURN_URL=https://api.creadentsmiles.com/api/icici/response
ICICI_REDIRECT_URL=https://api.creadentsmiles.com/api/icici/response
ICICI_CALLBACK_URL=https://api.creadentsmiles.com/api/icici/callback