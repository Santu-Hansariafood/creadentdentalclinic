PORT=25000
MONGODB_URI=mongodb://localhost:27017/creadent
JWT_SECRET=your_jwt_secret_key

# Local development (default)
# FRONTEND_URL=http://localhost:3000
# NODE_ENV=development

# Production
FRONTEND_URL=https://creadentsmiles.com
# Optional HTTPS Android App Link or custom deep link used only after callback verification.
# Do not use this as ICICI_RETURN_URL. The ICICI portal must register the API callback below.
# ICICI_SUCCESS_REDIRECT_URL=https://creadentsmiles.com/billing
NODE_ENV=production

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
# Meta webhook configuration
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose_a_private_verification_token
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_TEMPLATE_LANGUAGE=EN_US
WHATSAPP_TEMPLATE_APPOINTMENT_BOOKED_PATIENT=order_confirm_auto_schedule
WHATSAPP_TEMPLATE_APPOINTMENT_RESCHEDULED_PATIENT=appointment_rescheduled_patient
WHATSAPP_TEMPLATE_APPOINTMENT_RESCHEDULED_DOCTOR=appointment_rescheduled_doctor
WHATSAPP_TEMPLATE_APPOINTMENT_RESCHEDULED_EMPLOYEE=appointment_rescheduled_employee
WHATSAPP_TEMPLATE_APPOINTMENT_BOOKED_DOCTOR=appointment_booked_doctor
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER_PATIENT=appointment_reminder_patient
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER_DOCTOR=appointment_reminder_doctor
WHATSAPP_TEMPLATE_PRESCRIPTION=prescription_ready
WHATSAPP_TEMPLATE_INVOICE_SHARE=invoice_share
WHATSAPP_TEMPLATE_LOGIN_CREDENTIALS=creadent_invoice_share
WHATSAPP_TEMPLATE_FORGOT_PASSWORD_OTP=creadentotp
WHATSAPP_TEMPLATE_MANUAL_MESSAGE=manual_message
WHATSAPP_TEMPLATE_PAYMENT_THANK_YOU=payment_thank_you
WHATSAPP_TEMPLATE_INVOICE_PAYMENT_LINK=invoice_payment_link
WHATSAPP_REVIEW_LINK=https://g.co/kgs/TC3ksdW
WHATSAPP_REMINDER_POLL_INTERVAL_MS=300000

# Email (SMTP / Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=test@gmail.com
SMTP_PASS=your_gmail_app_password_here

# SpaceByte Cloud Storage REST API (optional; falls back to local uploads when blank)
# SPACEBYTE_PARENT_ID is optional and must be a SpaceByte folder ID.
UPLOAD_MAX_FILE_SIZE_MB=50
SPACEBYTE_ENDPOINT=https://spacebyte.in/api/v1
# Use the API key from SpaceByte API settings, not an S3 secret.
SPACEBYTE_API_TOKEN=your_spacebyte_api_token
# SPACEBYTE_ACCESS_KEY=your_spacebyte_api_key
SPACEBYTE_BUCKET=Creadent
SPACEBYTE_REGION=auto
SPACEBYTE_BASE_URL=https://spacebyte.in/api/v1
# SPACEBYTE_PARENT_ID=
SPACEBYTE_UPLOAD_TIMEOUT_MS=120000

# ============================================================
# ICICI Bank Payment Gateway - UAT SETUP
# ============================================================
# Use this configuration with the UAT merchant kit provided by ICICI Bank
ICICI_ENV=uat
ICICI_MERCHANT_ID=100000000007164
ICICI_AGGREGATOR_ID=A100000000007164
ICICI_SECRET_KEY=db06cca0-838b-4e01-8b20-6ac446ffb6bd
ICICI_CURRENCY_CODE=356
ICICI_PAY_TYPE=0

ICICI_INITIATE_SALE_URL=https://pgpayuat.icici.bank.in/tsp/pg/api/v2/initiateSale
ICICI_STATUS_CHECK_URL=https://pgpayuat.icici.bank.in/tsp/pg/api/command

# URL values must match exactly what is registered in the ICICI merchant portal
ICICI_RETURN_URL=https://api.creadentsmiles.com/api/icici/response
ICICI_REDIRECT_URL=https://api.creadentsmiles.com/api/icici/response
ICICI_CALLBACK_URL=https://api.creadentsmiles.com/api/icici/callback